{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust Debug (Helloworld)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    // 💡 明确告诉 Cargo 编译哪个子文件夹下的项目
                    "--manifest-path=${workspaceFolder}/helloworld/Cargo.toml"
                ]
            },
            "args": [],
            // 💡 运行路径也切换到子文件夹
            "cwd": "${workspaceFolder}/helloworld"
        }
    ]
}